MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
RESEND_API_KEY=re_...
EMAIL_FROM=EchoVest <verification@your-domain.example>
# Add the origins used by your browser, comma-separated (include your phone's LAN URL for local testing).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.146:3000
BACKEND_PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required to enable the /admin console. These credentials seed/update the super-admin account at backend startup.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
SESSION_SAME_SITE=lax
NODE_ENV=development
