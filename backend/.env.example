MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
RESEND_API_KEY=re_...
EMAIL_FROM=EchoVest <verification@your-domain.example>
# Add the origins used by your browser, comma-separated (include your phone's LAN URL for local testing).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.146:3000
# Optional for passkeys. Defaults to the hostname in the first FRONTEND_URL origin.
WEBAUTHN_RP_ID=
BACKEND_PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required to enable the /admin console. These credentials seed/update the super-admin account at backend startup.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
SESSION_SAME_SITE=lax
NODE_ENV=development
# Optional: generate with `npx web-push generate-vapid-keys` and set all three values to enable Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example

# Deposit prototype. `mock` works only with NODE_ENV=development. Keep the
# live-deposit switch false: this prototype never credits live user balances.
DEPOSIT_PROVIDER_MODE=mock
CHAINPAY_LIVE_DEPOSITS_ENABLED=false
CHAINPAY_API_KEY=
CHAINPAY_FORWARD_ADDRESS=replace-with-a-TRON-address-only-if-live-deposits-are-approved
CHAINPAY_CALLBACK_URL=https://api.example.com/api/webhooks/chainpay
CHAINPAY_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
TRON_NETWORK=mainnet
# Pinned official USDT TRC20 mainnet contract; live startup rejects any other value.
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_MIN_CONFIRMATIONS=19
